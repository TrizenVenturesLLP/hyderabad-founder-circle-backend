# Copy to .env and fill in values.
# If your password contains @, encode it as %40 in the URI.

PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.zaaoi9l.mongodb.net/hfn?appName=Cluster0
CORS_ORIGIN=http://localhost:8080

# Admin panel — platform super-admin (sees All Events)
ADMIN_EMAIL=admin@trizenventures.com
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_NAME=Platform Admin

# Trizen Ventures organization login (own events only)
TRIZEN_ORG_EMAIL=trizen@trizenventures.com
TRIZEN_ORG_PASSWORD=TrizenOrg123!
TRIZEN_ORG_NAME=Trizen Ventures

# NanoSpace Coworking organization login (own events only)
NANOSPACE_ORG_EMAIL=nanospace@nanospace.in
NANOSPACE_ORG_PASSWORD=NanoSpace123!
NANOSPACE_ORG_NAME=NanoSpace Coworking

JWT_SECRET=replace-with-a-long-random-secret

# Email microservice (RSVP confirmations + admin reminders)
EMAIL_SERVICE_URL=http://127.0.0.1:4007
EMAIL_SERVICE_AUTH_TOKEN=
WEB_APP_URL=https://community.trizenventures.com

# Razorpay (₹99 registration)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret

# MinIO image storage
MINIO_ENDPOINT=https://minio.example.com
MINIO_SERVER_URL=https://minio.example.com
MINIO_ROOT_USER=replace-with-access-key
MINIO_ROOT_PASSWORD=replace-with-secret-key
MINIO_REGION_NAME=eu-east-1
MINIO_TRANSACTION_BUCKET_NAME=transaction-proof
MINIO_QR_PAYMENT_BUCKET_NAME=qr-image
